# Configuração do Chegô no servidor (VPS). No servidor, copie para ".env"
# (na mesma pasta do docker-compose.yml) e troque os valores. Nunca envie o .env para o git.

# Domínio que já aponta para o IP da VPS (registro A). O HTTPS é automático.
DOMAIN=chego.seudominio.com.br

# Usuário e senha que o navegador pede para abrir o site (homologação).
# Gere o hash no servidor com:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'sua-senha'
# Deixe o hash entre aspas simples (ele tem "$").
BASIC_AUTH_USER=chego
BASIC_AUTH_HASH='$2a$14$troque-pelo-hash-gerado'

# Senha do PostgreSQL. Use só letras e números. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Segredo que assina os avisos do gateway simulado. Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=troque-por-um-segredo-longo

# "local" = homologação (código 123456, página /dev, pagamento simulado). Não mude
# enquanto o SMS e o gateway forem simulados: em outro modo ninguém recebe o código de login.
APP_ENV=local

# 1 = cria os dados de teste quando o banco sobe vazio pela primeira vez.
SEED_IF_EMPTY=1

# Notificações push (opcional). Gere no seu computador com: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
