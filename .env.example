# Copie este arquivo para .env.local (nunca envie o .env.local para o git).
# Os valores abaixo servem só para este computador e não são segredos de verdade.

# "local" mostra a faixa "Ambiente de testes" e libera os atalhos de teste.
APP_ENV=local

# Endereço do PostgreSQL local, ligado por `npm run db:start`.
# Só o servidor do app usa este endereço; ele nunca vai para o navegador.
DATABASE_URL=postgres://chego@127.0.0.1:54329/chego

# Permite entrar com um nome de usuário em vez de e-mail: "admin" vira
# "admin@chego.local". Só para o ambiente local.
LOGIN_USERNAME_DOMAIN=chego.local

# Provedor de pagamento: "mock" (simulado). Usado a partir da Etapa 7.
PAYMENT_PROVIDER=mock


# ---------------------------------------------------------------------------
# PRODUÇÃO (futuro). Não preencha agora.
# ---------------------------------------------------------------------------
# APP_ENV=production
# DATABASE_URL=endereço do PostgreSQL na nuvem, com usuário e senha (segredo!)
# PAYMENT_PROVIDER=nome-do-gateway
# PAYMENT_API_KEY=chave secreta do gateway (segredo!)
# PAYMENT_WEBHOOK_SECRET=segredo para validar a assinatura dos webhooks (segredo!)
# (LOGIN_USERNAME_DOMAIN não deve existir em produção)
