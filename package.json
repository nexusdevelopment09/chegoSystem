{
  "name": "chego",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "node scripts/db.ts start",
    "db:stop": "node scripts/db.ts stop",
    "db:reset": "node scripts/db.ts reset",
    "db:status": "node scripts/db.ts status",
    "db:migrate": "node scripts/db.ts migrate",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run simulate:test && npm run test:e2e",
    "db:types": "node scripts/db-types.ts",
    "seed:images": "node db/seed/images.ts",
    "push:keys": "web-push generate-vapid-keys",
    "simulate": "vitest run --config vitest.simulate.config.ts",
    "simulate:test": "vitest run --config vitest.simulate.config.ts --mode test-db",
    "sandbox:fees": "vitest run --config vitest.simulate.config.ts tests/simulation/fee-sandbox.test.ts",
    "sandbox:fees:clean": "node --env-file=.env.local scripts/sandbox-clean.ts",
    "seed:photos": "node scripts/ai-photos.ts",
    "deploy:vps": "node scripts/deploy-vps.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
